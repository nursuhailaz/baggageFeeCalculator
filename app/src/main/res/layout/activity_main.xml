<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F0FA"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#6A1B9A"
        app:title="Baggage Fee Estimator"
        app:titleTextColor="#FFFFFF"/>

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculate your excess baggage charges"
            android:textSize="16sp"
            android:textColor="#12051F"
            android:gravity="center"
            android:layout_marginBottom="14dp"/>

        <!-- Baggage Weight -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Baggage Weight (kg)"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#000000"/>

        <EditText
            android:id="@+id/number1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter baggage weight"
            android:textSize="16sp"
            android:inputType="numberDecimal"
            android:layout_marginTop="4dp"/>

        <!-- Ticket Class -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ticket Class"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="16sp"
            android:layout_marginTop="14dp"/>

        <RadioGroup
            android:id="@+id/radioGroupClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/btnEconomy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Economy (20 kg)"/>

            <RadioButton
                android:id="@+id/btnBusiness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Business (40 kg)"/>

        </RadioGroup>

        <!-- Excess Baggage Rate -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Excess Baggage Rate (RM/kg)"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="16sp"
            android:layout_marginTop="14dp"/>

        <EditText
            android:id="@+id/number2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter rate per kg"
            android:textSize="16sp"
            android:inputType="numberDecimal"
            android:layout_marginTop="4dp"/>

        <!-- Calculate Button -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnCalculate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Calculate"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6A1B9A"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Reset"
                android:textColor="#FFFFFF"
                android:backgroundTint="#757575"
                android:layout_marginEnd="5dp"
                android:textSize="14sp"
                android:layout_weight="1"/>

        </LinearLayout>

        <!-- Calculation Results -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your calculation results will appear here."
            android:textSize="16sp"
            android:textColor="#000000"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

</LinearLayout>